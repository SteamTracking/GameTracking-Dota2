// CItemGeneric
@PointClass base(item) = item_generic
[
	spawn_particles(particlesystem) // FIELD_HPARTICLESYSTEMDEFINITION m_hSpawnParticleEffect
	spawn_sound(string) // FIELD_STRING m_pAmbientSoundEffect
	auto_start_ambient_sound(boolean) // FIELD_BOOLEAN m_bAutoStartAmbientSound
	spawn_script_func(string) // FIELD_STRING m_pSpawnScriptFunction
	pickup_particles(particlesystem) // FIELD_HPARTICLESYSTEMDEFINITION m_hPickupParticleEffect
	pickup_sound(string) // FIELD_STRING m_pPickupSoundEffect
	pickup_script_func(string) // FIELD_STRING m_pPickupScriptFunction
	timeout_particles(particlesystem) // FIELD_HPARTICLESYSTEMDEFINITION m_hTimeoutParticleEffect
	timeout_sound(string) // FIELD_STRING m_pTimeoutSoundEffect
	timeout_script_func(string) // FIELD_STRING m_pTimeoutScriptFunction
	pickup_filter_name(string) // FIELD_STRING m_pPickupFilterName
	allow_pickup_script_func(string) // FIELD_STRING m_pAllowPickupScriptFunction
	pickup_radius_override(float) // FIELD_FLOAT32 m_flPickupRadius
	trigger_radius(float) // FIELD_FLOAT32 m_flTriggerRadius
	trigger_sound(string) // FIELD_STRING m_pTriggerSoundEffect
	glow_in_trigger_radius(boolean) // FIELD_BOOLEAN m_bGlowWhenInTrigger
	glowcolor(color255) // FIELD_COLOR32 m_glowColor
	useable(boolean) // FIELD_BOOLEAN m_bUseable
	auto_remove_timeout(float) // FIELD_FLOAT32
	drag_override(float) // FIELD_FLOAT32
	damping_override(float) // FIELD_FLOAT32
	input StartAmbientSound(void)
	input StopAmbientSound(void)
	input ToggleAmbientSound(void)
	output OnPickup(void)
	output OnTimeout(void)
	output OnTriggerEndTouch(void)
	output OnTriggerStartTouch(void)
	output OnTriggerTouch(void)
]

// CItemGenericTriggerHelper
@PointClass base(basemodelentity) = item_generic_trigger_helper
