// Datamaps that no entity class has, like modifiers and structs that only code fills

@BaseClass = CAnimationLayer
[
	// m_op (CNetworkedSequenceOperation)
		cycle(float) // FIELD_FLOAT32 m_flCycle
		sequenceName(string) // FIELD_UTLSTRING
		sequence(integer) // FIELD_INT32
]

@BaseClass = CEnvWindShared
[
	minwind(integer) // FIELD_UINT16 m_iMinWind
	maxwind(integer) // FIELD_UINT16 m_iMaxWind
	windradius(integer) // FIELD_INT32 m_windRadius
	mingust(integer) // FIELD_UINT16 m_iMinGust
	maxgust(integer) // FIELD_UINT16 m_iMaxGust
	mingustdelay(float) // FIELD_FLOAT32 m_flMinGustDelay
	maxgustdelay(float) // FIELD_FLOAT32 m_flMaxGustDelay
	gustduration(float) // FIELD_FLOAT32 m_flGustDuration
	gustdirchange(integer) // FIELD_UINT16 m_iGustDirChange
]

@BaseClass = CSequenceTransitioner2
[
	// m_currentOp (CNetworkedSequenceOperation)
		cycle(float) // FIELD_FLOAT32 m_flCycle
		sequenceName(string) // FIELD_UTLSTRING
		sequence(integer) // FIELD_INT32
]

@BaseClass = TransitioningLayer_t
[
	// m_op (CNetworkedSequenceOperation)
		cycle(float) // FIELD_FLOAT32 m_flCycle
		sequenceName(string) // FIELD_UTLSTRING
		sequence(integer) // FIELD_INT32
]

@BaseClass = locksound_t
[
	locked_sound(sound) // FIELD_SOUNDNAME sLockedSound
	unlocked_sound(sound) // FIELD_SOUNDNAME sUnlockedSound
]

