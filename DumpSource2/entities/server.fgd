	input SetMoverFaceEntity(target_destination) : "Set the movers face entity" // PVAL_EHANDLE hFaceEntity, Pulse node
	input SetMoverOffsetFromPath(vector) : "Set the offset from the spline the mover rides at, in the movers own space. The mover snaps to the new offset, its location along the path is unchanged." // PVAL_VEC3 vOffset, Pulse node
	input SetOffsetFromPath(vector) // PVAL_VEC3 param
