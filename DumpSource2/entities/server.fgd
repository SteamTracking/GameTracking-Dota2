// CRopeKeyframe
@PointClass base(basemodelentity) = keyframe_rope
[
	NextKey(string) // FIELD_STRING m_iNextLinkName
	Slack(integer) // FIELD_INT16 m_Slack
	Width(float) // FIELD_FLOAT32 m_Width
	TextureScale(float) // FIELD_FLOAT32 m_TextureScale
	SegmentCount(integer) // FIELD_UINT8 m_nSegments
	Subdiv(integer) // FIELD_UINT8 m_Subdiv
	ScrollSpeed(float) // FIELD_FLOAT32 m_flScrollSpeed
	Breakable(integer) // FIELD_INT32
	Collide(integer) // FIELD_INT32
	Barbed(integer) // FIELD_INT32
	UseWind(integer) // FIELD_INT32
	Dangling(integer) // FIELD_INT32
	Type(integer) // FIELD_INT32
	RopeShader(integer) // FIELD_INT32
	RopeMaterial(string) // FIELD_UTLSTRING
	input Break(void)
	input SetForce(vector) // PVAL_VEC3 param
	input SetScrollSpeed(float) // PVAL_FLOAT param
]

// CPathKeyFrame
@PointClass base(CLogicalEntity) = keyframe_track
[
