	held_weapon_behavior(intchoices) : "held_weapon_behavior" : : "" = // FIELD_INT32 m_nHeldWeaponBehavior (ScriptedHeldWeaponBehavior_t)
	[
		-1 : "eInvalid"
		0 : "eHolster"
		1 : "eDeploy"
		2 : "eDrop"
	]
	forced_crouch_state(intchoices) : "forced_crouch_state" : : "" = // FIELD_INT32 m_nForcedCrouchState (ForcedCrouchState_t)
	[
		0 : "FORCEDCROUCH_NONE"
		1 : "FORCEDCROUCH_CROUCHED"
		2 : "FORCEDCROUCH_UNCROUCHED"
	]
	m_flRadius(float) // FIELD_FLOAT32 m_flRadius
	m_flRepeat(float) // FIELD_FLOAT32 m_flRepeat
	m_flMoveInterpTime(float) // FIELD_FLOAT32 m_flMoveInterpTime
	m_flAngRate(float) // FIELD_FLOAT32 m_flAngRate
	m_flMoveSpeed(float) // FIELD_FLOAT32 m_flMoveSpeed
	m_bWaitUntilMoveCompletesToStartAnimation(boolean) // FIELD_BOOLEAN m_bWaitUntilMoveCompletesToStartAnimation
	m_flPlayAnimFadeInTime(float) // FIELD_FLOAT32 m_flPlayAnimFadeInTime
	m_bLoopPreIdleSequence(boolean) // FIELD_BOOLEAN m_bLoopPreIdleSequence
	m_bLoopActionSequence(boolean) // FIELD_BOOLEAN m_bLoopActionSequence
	m_bLoopPostIdleSequence(boolean) // FIELD_BOOLEAN m_bLoopPostIdleSequence
	m_bSynchPostIdles(boolean) // FIELD_BOOLEAN m_bSynchPostIdles
	m_bIgnoreGravity(boolean) // FIELD_BOOLEAN m_bIgnoreGravity
	m_bIgnoreLookAt(boolean) // FIELD_BOOLEAN m_bIgnoreLookAt
	m_bDisableNPCCollisions(boolean) // FIELD_BOOLEAN m_bDisableNPCCollisions
	m_bKeepAnimgraphLockedPost(boolean) // FIELD_BOOLEAN m_bKeepAnimgraphLockedPost
	m_bDontAddModifiers(boolean) // FIELD_BOOLEAN m_bDontAddModifiers
	disable_aim_while_moving(boolean) // FIELD_BOOLEAN m_bDisableAimingWhileMoving
	ignore_rotation(boolean) // FIELD_BOOLEAN m_bIgnoreRotation
	dont_rotate_other(boolean) // FIELD_BOOLEAN m_bDontRotateOther
	repeatable(boolean) // FIELD_BOOLEAN m_bIsRepeatable
	should_leave_corpse(boolean) // FIELD_BOOLEAN m_bShouldLeaveCorpse
	start_on_spawn(boolean) // FIELD_BOOLEAN m_bStartOnSpawn
	no_interrupts(boolean) // FIELD_BOOLEAN m_bDisallowInterrupts
	can_override_npc_state(boolean) // FIELD_BOOLEAN m_bCanOverrideNPCState
	no_teleport_at_end(boolean) // FIELD_BOOLEAN m_bDontTeleportAtEnd
	high_priority(boolean) // FIELD_BOOLEAN m_bHighPriority
	hide_debug_complaints(boolean) // FIELD_BOOLEAN m_bHideDebugComplaints
	continue_on_death(boolean) // FIELD_BOOLEAN m_bContinueOnDeath
	m_bPositionRelativeToOtherEntity(boolean) // FIELD_BOOLEAN m_bPositionRelativeToOtherEntity
	onnpcdeath(intchoices) : "onnpcdeath" : : "" = // FIELD_INT32 m_onDeathBehavior (ScriptedOnDeath_t)
	[
		-1 : "SS_ONDEATH_NOT_APPLICABLE"
		0 : "SS_ONDEATH_UNDEFINED"
		1 : "SS_ONDEATH_RAGDOLL"
		2 : "SS_ONDEATH_ANIMATED_DEATH"
	]
	m_bAllowCustomInterruptConditions(boolean) // FIELD_BOOLEAN m_bAllowCustomInterruptConditions
	conflict_response(intchoices) : "conflict_response" : : "" = // FIELD_INT32 m_ConflictResponse (ScriptedConflictResponse_t)
	[
		0 : "SS_CONFLICT_ENQUEUE"
		1 : "SS_CONFLICT_INTERRUPT"
	]
	prevent_update_yaw_on_finish(boolean) // FIELD_BOOLEAN m_bPreventUpdateYawOnFinish
	ensure_on_navmesh_on_finish(boolean) // FIELD_BOOLEAN m_bEnsureOnNavmeshOnFinish
	onplayerdeath(integer) // FIELD_INT32 m_iPlayerDeathBehavior
	input BeginSequence(void)
	input CancelSequence(void)
	input ForceTarget(string) // PVAL_STRING param
	input MoveToPosition(void)
	input ScriptPlayerDeath(void)
	input SetActionSequence(string) // PVAL_STRING param
