// CSceneEntity
@PointClass base(point_entity) = scripted_scene
[
	SceneFile(string) // FIELD_STRING m_iszSceneFile
	target1(string) // FIELD_STRING m_iszTarget1
	target2(string) // FIELD_STRING m_iszTarget2
	target3(string) // FIELD_STRING m_iszTarget3
	target4(string) // FIELD_STRING m_iszTarget4
	target5(string) // FIELD_STRING m_iszTarget5
	target6(string) // FIELD_STRING m_iszTarget6
	target7(string) // FIELD_STRING m_iszTarget7
	target8(string) // FIELD_STRING m_iszTarget8
	busyactor(integer) // FIELD_INT32 m_BusyActor
	locator_origin_entity(target_destination) // FIELD_EHANDLE m_hLocatorOrigin
	target_attachment(string) // FIELD_STRING m_sTargetAttachment
	sound_for_scene(string) // FIELD_STRING m_iszSoundName
	sequence_for_scene(string) // FIELD_STRING m_iszSequenceName
	onplayerdeath(intchoices) : "onplayerdeath" : : "" = // FIELD_INT32 m_iPlayerDeathBehavior (SceneOnPlayerDeath_t)
	[
		0 : "SCENE_ONPLAYERDEATH_DO_NOTHING"
		1 : "SCENE_ONPLAYERDEATH_CANCEL"
	]
	input Cancel(void)
	input CancelAtNextInterrupt(void)
	input InterjectResponse(string) // PVAL_STRING param
	input Pause(void)
	input PauseAtNextInterrupt(void)
	input PitchShift(float) // PVAL_FLOAT param
	input Resume(void)
	input ScriptPlayerDeath(void)
	input SetTarget1(string) // PVAL_STRING param
	input SetTarget2(string) // PVAL_STRING param
	input Start(void)
	input StopWaitingForActor(void)
	output OnCanceled(void)
	output OnCompletion(void)
	output OnPaused(void)
	output OnPulseRequirement(void)
	output OnResumed(void)
	output OnStart(void)
]

