// CTriggerFan
@PointClass base(trigger) = trigger_fan
[
	fan_push_away_from_info_fan(boolean) // FIELD_BOOLEAN m_bPushAwayFromInfoTarget
	fan_push_towards_info_fan(boolean) // FIELD_BOOLEAN m_bPushTowardsInfoTarget
	fan_force(float) // FIELD_FLOAT32 m_flForce
	fan_falloff(boolean) // FIELD_BOOLEAN m_bFalloff
]

// C_TriggerPhysics
@PointClass base(trigger) = trigger_physics
[
	SetGravityScale(float) // FIELD_FLOAT32 m_gravityScale
	SetVelocityLimit(float) // FIELD_FLOAT32 m_linearLimit
	SetVelocityDamping(float) // FIELD_FLOAT32 m_linearDamping
	SetAngVelocityLimit(float) // FIELD_FLOAT32 m_angularLimit
	SetAngVelocityDamping(float) // FIELD_FLOAT32 m_angularDamping
	SetLinearForce(float) // FIELD_FLOAT32 m_linearForce
	LinearForcePointAt(vector) // FIELD_VECTOR m_vecLinearForcePointAt
	CollapseToForcePoint(boolean) // FIELD_BOOLEAN m_bCollapseToForcePoint
	SetFrequency(float) // FIELD_FLOAT32 m_flFrequency
	SetDampingRatio(float) // FIELD_FLOAT32 m_flDampingRatio
	ConvertToDebrisWhenPossible(boolean) // FIELD_BOOLEAN m_bConvertToDebrisWhenPossible
	input CollapseToForcePoint(boolean) // PVAL_BOOL param
	input LinearForcePointAt(vector) // PVAL_VEC3 param
	input SetAngVelocityDamping(float) // PVAL_FLOAT param
	input SetAngVelocityLimit(float) // PVAL_FLOAT param
	input SetDampingRatio(float) // PVAL_FLOAT param
	input SetFrequency(float) // PVAL_FLOAT param
	input SetGravityScale(float) // PVAL_FLOAT param
	input SetLinearForce(float) // PVAL_FLOAT param
	input SetVelocityDamping(float) // PVAL_FLOAT param
	input SetVelocityLimit(float) // PVAL_FLOAT param
]

