[
	FOV(float) // FIELD_FLOAT32 m_FOV
	zNear(float) // FIELD_FLOAT32 m_flZNear
	zFar(float) // FIELD_FLOAT32 m_flZFar
	resolution(float) // FIELD_FLOAT32 m_Resolution
	fogEnable(boolean) // FIELD_BOOLEAN m_bFogEnable
	fogColor(color255) // FIELD_COLOR32 m_FogColor
	fogStart(float) // FIELD_FLOAT32 m_flFogStart
	fogEnd(float) // FIELD_FLOAT32 m_flFogEnd
	fogMaxDensity(float) // FIELD_FLOAT32 m_flFogMaxDensity
	UseScreenAspectRatio(boolean) // FIELD_BOOLEAN m_bUseScreenAspectRatio
	aspectRatio(float) // FIELD_FLOAT32 m_flAspectRatio
	override_shadow_farz(float) // FIELD_FLOAT32 m_flOverrideShadowFarZ
	hltvUsable(boolean) // FIELD_BOOLEAN m_bCanHLTVUse
	align_with_parent(boolean) // FIELD_BOOLEAN m_bAlignWithParent
	dof_enabled(boolean) // FIELD_BOOLEAN m_bDofEnabled
	dof_near_blurry(float) // FIELD_FLOAT32 m_flDofNearBlurry
	dof_near_crisp(float) // FIELD_FLOAT32 m_flDofNearCrisp
	dac_dof_far_crisp(float) // FIELD_FLOAT32 m_flDofFarCrisp
	dac_dof_far_blurry(float) // FIELD_FLOAT32 m_flDofFarBlurry
	dac_dof_tilt_to_ground(float) // FIELD_FLOAT32 m_flDofTiltToGround
	input Activate(void)
	input ChangeFOV(string) // PVAL_STRING param
	input Deactivate(void)
	input DisableDOF(void)
	input EnableDOF(void)
	input SetDOFFarBlurry(float) // PVAL_FLOAT param
	input SetDOFFarCrisp(float) // PVAL_FLOAT param
	input SetDOFNearBlurry(float) // PVAL_FLOAT param
	input SetDOFNearCrisp(float) // PVAL_FLOAT param
	input SetDOFTiltToGround(float) // PVAL_FLOAT param
	input SetOff(void)
	input SetOn(void)
	input SetOnAndTurnOthersOff(void)
]

