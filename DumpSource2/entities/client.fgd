// CLogicRelay
@PointClass base(CLogicalEntity) = logic_relay
[
	StartDisabled(boolean) // FIELD_BOOLEAN m_bDisabled
	TriggerOnce(boolean) // FIELD_BOOLEAN m_bTriggerOnce
	FastRetrigger(boolean) // FIELD_BOOLEAN m_bFastRetrigger
	PassthroughCaller(boolean) // FIELD_BOOLEAN m_bPassthoughCaller
	input CancelPending(void) : "Cancel any events fired by this relay that are currently pending in the I/O event queue." // Pulse node
	input Disable(void) : "Disable this entity." // Pulse node
	input Enable(void) : "Enable this entity." // Pulse node
	input EnableRefire(void)
	input Toggle(void) : "Toggle the relay between enabled and disabled." // Pulse node
	input Trigger(void) : "Trigger the relay, causing its OnTrigger output to fire if it is enabled." // Pulse node
	output OnSpawn(void) : "Fired when the relay is spawned. If the relay is set to only trigger once, it will delete itself after firing this output."
	output OnTrigger(void) : "Fired when the relay is triggered. If the relay is set to only trigger once, it will delete itself after firing this output."
]

