// C_LightEntity
@PointClass base(basemodelentity) = light_omni
[
	// component CLightComponent
		color(color255) // FIELD_COLOR32 m_Color
		secondary_color(color255) // FIELD_COLOR32 m_SecondaryColor
		brightness(float) // FIELD_FLOAT32 m_flBrightness
		brightnessscale(float) // FIELD_FLOAT32 m_flBrightnessScale
		range(float) // FIELD_FLOAT32 m_flRange
		falloff(float) // FIELD_FLOAT32 m_flFalloff
		attenuation0(float) // FIELD_FLOAT32 m_flAttenuation0
		attenuation1(float) // FIELD_FLOAT32 m_flAttenuation1
		attenuation2(float) // FIELD_FLOAT32 m_flAttenuation2
		innerconeangle(float) // FIELD_FLOAT32 m_flTheta
		outerconeangle(float) // FIELD_FLOAT32 m_flPhi
		lightcookie(resource:texture) // FIELD_HRENDERTEXTURE m_hLightCookie
		numcascades(integer) // FIELD_INT32 m_nCascades
		cascaderenderstaticobj(integer) // FIELD_INT32 m_nCascadeRenderStaticObjects
		cascadecrossfade(float) // FIELD_FLOAT32 m_flShadowCascadeCrossFade
		cascadedistancefade(float) // FIELD_FLOAT32 m_flShadowCascadeDistanceFade
		shadowcascadedistance0(float) // FIELD_FLOAT32 m_flShadowCascadeDistance0
		shadowcascadedistance1(float) // FIELD_FLOAT32 m_flShadowCascadeDistance1
		shadowcascadedistance2(float) // FIELD_FLOAT32 m_flShadowCascadeDistance2
		shadowcascadedistance3(float) // FIELD_FLOAT32 m_flShadowCascadeDistance3
		shadowcascaderesolution0(integer) // FIELD_INT32 m_nShadowCascadeResolution0
		shadowcascaderesolution1(integer) // FIELD_INT32 m_nShadowCascadeResolution1
		shadowcascaderesolution2(integer) // FIELD_INT32 m_nShadowCascadeResolution2
		shadowcascaderesolution3(integer) // FIELD_INT32 m_nShadowCascadeResolution3
		castshadows(integer) // FIELD_INT32 m_nCastShadows
		shadowtexturewidth(integer) // FIELD_INT32 m_nShadowWidth
		shadowtextureheight(integer) // FIELD_INT32 m_nShadowHeight
		baked_light_indexing(boolean) // FIELD_BOOLEAN m_bUsesBakedShadowing
		shadowpriority(integer) // FIELD_INT32 m_nShadowPriority
		bakedshadowindex(integer) // FIELD_INT32 m_nBakedShadowIndex
		light_path_uniqueid(integer) // FIELD_INT32 m_nLightPathUniqueId
		light_map_uniqueid(integer) // FIELD_INT32 m_nLightMapUniqueId
		renderdiffuse(boolean) // FIELD_BOOLEAN m_bRenderDiffuse
		renderspecular(integer) // FIELD_INT32 m_nRenderSpecular
		rendertransmissive(boolean) // FIELD_BOOLEAN m_bRenderTransmissive
		ortholightwidth(float) // FIELD_FLOAT32 m_flOrthoLightWidth
		ortholightheight(float) // FIELD_FLOAT32 m_flOrthoLightHeight
		style(integer) // FIELD_INT32 m_nStyle
		pattern(string) // FIELD_UTLSTRING m_Pattern
		directlight(integer) // FIELD_INT32 m_nDirectLight
		bouncelight(integer) // FIELD_INT32 m_nBounceLight
		bouncescale(float) // FIELD_FLOAT32 m_flBounceScale
		fademindist(float) // FIELD_FLOAT32 m_flFadeMinDist
		fademaxdist(float) // FIELD_FLOAT32 m_flFadeMaxDist
		shadowfademindist(float) // FIELD_FLOAT32 m_flShadowFadeMinDist
		shadowfademaxdist(float) // FIELD_FLOAT32 m_flShadowFadeMaxDist
		enabled(boolean) // FIELD_BOOLEAN m_bEnabled
		rendertocubemaps(boolean) // FIELD_BOOLEAN m_bRenderToCubemaps
		flicker(boolean) // FIELD_BOOLEAN m_bFlicker
		precomputedfieldsvalid(boolean) // FIELD_BOOLEAN m_bPrecomputedFieldsValid
		precomputedboundsmins(vector) // FIELD_POSITION_VECTOR m_vPrecomputedBoundsMins
		precomputedboundsmaxs(vector) // FIELD_POSITION_VECTOR m_vPrecomputedBoundsMaxs
		precomputedmaxrange(float) // FIELD_FLOAT32 m_flPrecomputedMaxRange
		precomputedobborigin(vector) // FIELD_POSITION_VECTOR m_vPrecomputedOBBOrigin
		precomputedobbangles(angle) // FIELD_QANGLE_WORLDSPACE m_vPrecomputedOBBAngles
		precomputedobbextent(vector) // FIELD_VECTOR m_vPrecomputedOBBExtent
		fog_lighting(integer) // FIELD_INT32 m_nFogLightingMode
		fogcontributionstrength(float) // FIELD_FLOAT32 m_flFogContributionStength
		nearclipplane(float) // FIELD_FLOAT32 m_flNearClipPlane
		skycolor(color255) // FIELD_COLOR32 m_SkyColor
		skyintensity(float) // FIELD_FLOAT32 m_flSkyIntensity
		skyambientbounce(color255) // FIELD_COLOR32 m_SkyAmbientBounce
		use_secondary_color(boolean) // FIELD_BOOLEAN m_bUseSecondaryColor
		capsule_length(float) // FIELD_FLOAT32 m_flCapsuleLength
		mixedshadows(boolean) // FIELD_BOOLEAN m_bMixedShadows
		minroughness(float) // FIELD_FLOAT32 m_flMinRoughness
		allow_sst_generation(boolean) // FIELD_BOOLEAN m_bAllowSSTGeneration
	input SetAppearance(integer) // PVAL_INT param
	input SetCustomAppearance(string) // PVAL_STRING param
	input SetLightBrightness(float) // PVAL_FLOAT param
	input SetLightColor(color255) // PVAL_COLOR_RGB param
	input SetLightEnabled(boolean) // PVAL_BOOL param
	input Toggle(void)
	input TurnOff(void)
	input TurnOn(void)
]

