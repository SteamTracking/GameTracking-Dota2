[
	StartDisabled(boolean) // FIELD_BOOLEAN m_bDisabled
	updateOnClient(boolean) // FIELD_BOOLEAN m_bUpdateOnClient
	inputType(intchoices) : "inputType" : : "" = // FIELD_INT32 m_nInputType (ValueRemapperInputType_t)
	[
		0 : "InputType_PlayerShootPosition"
		1 : "InputType_PlayerShootPositionAroundAxis"
	]
	maximumChangePerSecond(float) // FIELD_FLOAT32 m_flMaximumChangePerSecond
	maximumDistanceFromLine(float) // FIELD_FLOAT32 m_flDisengageDistance
	engageDistance(float) // FIELD_FLOAT32 m_flEngageDistance
	requiresUseKey(boolean) // FIELD_BOOLEAN m_bRequiresUseKey
	outputType(intchoices) : "outputType" : : "" = // FIELD_INT32 m_nOutputType (ValueRemapperOutputType_t)
	[
		0 : "OutputType_AnimationCycle"
		1 : "OutputType_RotationX"
		2 : "OutputType_RotationY"
		3 : "OutputType_RotationZ"
	]
	hapticsType(intchoices) : "hapticsType" : : "" = // FIELD_INT32 m_nHapticsType (ValueRemapperHapticsType_t)
	[
		0 : "HaticsType_Default"
		1 : "HaticsType_None"
	]
	momentumType(intchoices) : "momentumType" : : "" = // FIELD_INT32 m_nMomentumType (ValueRemapperMomentumType_t)
	[
		0 : "MomentumType_None"
		1 : "MomentumType_Friction"
		2 : "MomentumType_SpringTowardSnapValue"
		3 : "MomentumType_SpringAwayFromSnapValue"
	]
	momentumModifier(float) // FIELD_FLOAT32 m_flMomentumModifier
	snapValue(float) // FIELD_FLOAT32 m_flSnapValue
	ratchetType(intchoices) : "ratchetType" : : "" = // FIELD_INT32 m_nRatchetType (ValueRemapperRatchetType_t)
	[
		0 : "RatchetType_Absolute"
		1 : "RatchetType_EachEngage"
	]
	inputOffset(float) // FIELD_FLOAT32 m_flInputOffset
]

