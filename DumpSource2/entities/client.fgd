// C_PortraitWorldUnit
@PointClass base(npc_dota_base) = portrait_world_unit
[
	suppress_intro_effects(boolean) // FIELD_BOOLEAN m_bSuppressIntroEffects
	alternate_loadout(boolean) // FIELD_BOOLEAN m_bIsAlternateLoadout
	skip_background_entities(boolean) // FIELD_BOOLEAN m_bSkipBackgroundEntities
	spawn_background_models(boolean) // FIELD_BOOLEAN m_bSpawnBackgroundModels
	deferred_portrait(boolean) // FIELD_BOOLEAN m_bDeferredPortrait
	show_particle_asset_modifiers(boolean) // FIELD_BOOLEAN m_bShowParticleAssetModifiers
	ignore_portrait_info(boolean) // FIELD_BOOLEAN m_bIgnorePortraitInfo
	flying_courier(boolean) // FIELD_BOOLEAN m_bFlyingCourier
	effigy_status_effect(integer) // FIELD_INT32 m_nEffigyStatusEffect
	effigy_sequence_name(string) // FIELD_STRING m_effigySequenceName
	starting_anim_cycle(float) // FIELD_FLOAT32 m_flStartingAnimationCycle
	animation_playback_speed(float) // FIELD_FLOAT32 m_flAnimationPlaybackSpeed
	rare_loadout_anim_chance(float) // FIELD_FLOAT32 m_flRareLoadoutAnimChance
	activity_modifier(string) // FIELD_STRING
	portrait_environment(intchoices) : "portrait_environment" : : "" = // FIELD_INT32 m_environment (DOTAPortraitEnvironmentType_t)
	[
		-1 : "DOTA_PORTRAIT_ENVIRONMENT_INVALID"
		0 : "DOTA_PORTRAIT_ENVIRONMENT_DEFAULT"
		1 : "DOTA_PORTRAIT_ENVIRONMENT_FULL_BODY"
		2 : "DOTA_PORTRAIT_ENVIRONMENT_CARD"
		3 : "DOTA_PORTRAIT_ENVIRONMENT_WEBPAGE"
		4 : "DOTA_PORTRAIT_ENVIRONMENT_FULL_BODY_RIGHT_SIDE"
		5 : "DOTA_PORTRAIT_ENVIRONMENT_FULL_BODY_LOADOUT"
		6 : "DOTA_PORTRAIT_ENVIRONMENT_ICON"
		7 : "DOTA_PORTRAIT_ENVIRONMENT_SHOWCASE"
		8 : "DOTA_PORTRAIT_ENVIRONMENT_FIGHTING"
		9 : "DOTA_PORTRAIT_ENVIRONMENT_TYPE_COUNT"
	]
	startup_behavior(intchoices) : "startup_behavior" : : "" = // FIELD_INT32 m_nStartupBehavior (StartupBehavior_t)
	[
		0 : "UNIT_STARTUP_BEHAVIOR_DEFAULT"
		1 : "UNIT_STARTUP_BEHAVIOR_TAUNT"
	]
	camera_name(string) // FIELD_STRING m_cameraName
	skip_pet_spawn(boolean) // FIELD_BOOLEAN
	item_def0(integer) // FIELD_INT32
	item_def1(integer) // FIELD_INT32
	item_def2(integer) // FIELD_INT32
	item_def3(integer) // FIELD_INT32
	item_def4(integer) // FIELD_INT32
	item_def5(integer) // FIELD_INT32
	item_def6(integer) // FIELD_INT32
	item_def7(integer) // FIELD_INT32
	model_index(integer) // FIELD_INT32
	skin_override(integer) // FIELD_INT32
	StartDisabled(boolean) // FIELD_BOOLEAN
	activity(string) // FIELD_UTLSTRING
	style_index0(integer) // FIELD_INT32
	style_index1(integer) // FIELD_INT32
	style_index2(integer) // FIELD_INT32
	style_index3(integer) // FIELD_INT32
	style_index4(integer) // FIELD_INT32
	style_index5(integer) // FIELD_INT32
	style_index6(integer) // FIELD_INT32
	style_index7(integer) // FIELD_INT32
	input Disable(void)
	input DisableAutoFadeAndAutoKill(string) // PVAL_STRING param
	input DisableDefaultActivityModifiers(string) // PVAL_STRING param
	input Enable(void)
	input FadeAndDestroyGesture(string) // PVAL_STRING param
	input ForceLooping(string) // PVAL_STRING param
	input RemoveGesture(string) // PVAL_STRING param
	input SetActivity(string) // PVAL_STRING param
	input SetActivityModifier(string) // PVAL_STRING param
	input StartGestureOverride(string) // PVAL_STRING param
	output OnAnimationDone(void)
]

