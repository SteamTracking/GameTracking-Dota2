	teamnumber(integer) // FIELD_UINT8 m_iTeamNum, ADDED_KEYFIELD
	HasInventory(boolean) // FIELD_BOOLEAN m_bHasInventory
	AttackAcquisitionRange(integer) // FIELD_INT32 m_iAcquisitionRange
	econ_owner(target_destination) // FIELD_EHANDLE
	EconItemCount(integer) // FIELD_INT32
	inPortrait(boolean) // FIELD_BOOLEAN
	EnableAutoStyles(boolean) // FIELD_BOOLEAN
